# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=conversationai
DATABASE_USER=postgres
DATABASE_PASSWORD=admin123
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Gemini LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# CRM Webhook Configuration
CRM_WEBHOOK_URL=https://your-crm-webhook-url.com/webhook
CRM_WEBHOOK_TIMEOUT=30
CRM_WEBHOOK_RETRY_ATTEMPTS=3

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# LangChain Settings
LANGCHAIN_VERBOSE=False
LANGCHAIN_CACHE_TYPE=memory
LANGCHAIN_TEMPERATURE=0.7
LANGCHAIN_MAX_TOKENS=1024
LANGCHAIN_CONVERSATION_MEMORY_TYPE=buffer
LANGCHAIN_CONVERSATION_MEMORY_K=10
